#!/usr/bin/env bash
set -euo pipefail

# Block direct pushes to main unless explicitly allowed.
current_branch=$(git rev-parse --abbrev-ref HEAD)
remote_name=$1
remote_url=$(git remote get-url "$remote_name" 2>/dev/null || echo "")

if [[ "$current_branch" == "main" ]]; then
  if [[ "${ALLOW_MAIN_PUSH:-}" != "1" ]]; then
    echo "\n[guard] Direct pushes to main are blocked.\n"
    echo "Create a feature branch (see docs/branching.md) and open a PR.\n"
    echo "To override once: ALLOW_MAIN_PUSH=1 git push $remote_name $current_branch\n"
    exit 1
  fi
fi

# Soft naming check (warn only): feat|fix|docs|refactor|test|chore
if [[ ! "$current_branch" =~ ^(feat|fix|docs|refactor|test|chore|integration)/.+$ && "$current_branch" != "main" ]]; then
  echo "[guard] Branch '$current_branch' does not follow naming convention. (See docs/branching.md)"
fi

exit 0

